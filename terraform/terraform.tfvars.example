# Copy to terraform.tfvars; generate a secret with: openssl rand -hex 32
# Never commit the resulting terraform.tfvars file.
k3s_token = "REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Optional overrides. See variables.tf for defaults, types, and validation.
# ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# network_cidr        = "192.168.100.0/24"
# k3s_version         = "v1.36.4+k3s1"
# Override the complete nodes map to change per-node CPU, RAM, and disk budgets.
