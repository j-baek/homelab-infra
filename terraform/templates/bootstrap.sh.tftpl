#!/bin/sh
# Retryable first-boot setup. Never trace commands: configuration holds secrets.
set -eu
if [ -f /var/lib/homelab/bootstrap-complete ]; then
    exit 0
fi
export DEBIAN_FRONTEND=noninteractive
apt-get -o Acquire::Retries=3 update
apt-get -o Acquire::Retries=3 install -y curl ca-certificates
swapoff -a
curl --fail --silent --show-error --location --retry 5 \
    https://get.k3s.io -o /run/install-k3s.sh
INSTALL_K3S_VERSION='${version}' INSTALL_K3S_EXEC='${role}' sh /run/install-k3s.sh
mkdir -p /var/lib/homelab
# This marker means installation succeeded, not that the cluster is ready.
touch /var/lib/homelab/bootstrap-complete
